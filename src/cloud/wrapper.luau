--[[studio-run cloud wrapper]]
-- Generated by studio-run for each `--cloud` run: the task script of an Open
-- Cloud Luau Execution task. Runs the user's script and reports what happens
-- as the same events as the local wrapper (src/wrapper.luau).
--
-- Differences from the local wrapper (see docs/internals/cloud-behavior.md):
-- * Tasks have no loadstring, so the user's source is compiled as a
--   ModuleScript named after the file, wrapped in `return function(...)`.
--   With --trace-modules, required ModuleScripts are compiled the same way.
-- * Events are collected and returned in the task's binary output, followed
--   by the script's own binary output. Each event is also printed, so a task
--   that times out still leaves them in its logs.
-- * --input files arrive packed in the task's one binary input.

local TASK_ARGS = table.pack(...) -- { BinaryInput = buffer } with --input
local CHUNK_NAME = __SR_CHUNK__ -- "name.luau": used in errors and tracebacks
local CAPTURE_PRINT = __SR_CAPTURE__
local TRACE_MODULES = __SR_TRACE__
local SEND_BINARY_OUTPUT = __SR_BINARY_OUTPUT__ -- --binary-output was given
-- The script's first vararg (`local ctx = ...`); see docs/guide/writing-scripts.md.
-- `inputs` and `setBinaryOutput` are added below.
local CONTEXT = __SR_CONTEXT__
-- Only known once the task runs when it's the latest version.
CONTEXT.place.version = game.PlaceVersion
local SOURCE = __SR_SOURCE__

local PROTOCOL = 1
local SENTINEL = "@@studio" .. "-run@@"
local BUDGET = 600 -- max JSON-encoded bytes of one message piece
local MAX_TASK_OUTPUT = 256 * 1024 * 1024 -- a task's binary output

local HttpService = game:GetService("HttpService")
local LogService = game:GetService("LogService")
local ScriptContext = game:GetService("ScriptContext")
local realPrint = print
local realRequire = require
local wrapperEnv = getfenv(1)

local scriptNames = { [CHUNK_NAME] = true } -- chunks whose errors are the script's

---------------------------------------------------------------------------
-- Event output
---------------------------------------------------------------------------

local seq = 0
local lines = {}
local linesBytes = 0

local function send(ev)
	seq += 1
	ev.v = PROTOCOL
	ev.seq = seq
	local line = SENTINEL .. HttpService:JSONEncode(ev)
	table.insert(lines, line)
	linesBytes += #line + 1
	realPrint(line)
end

-- Replace invalid UTF-8 so JSONEncode can't fail.
local function sanitize(s)
	local len, bad = utf8.len(s)
	while not len do
		s = string.sub(s, 1, bad - 1) .. "\u{FFFD}" .. string.sub(s, bad + 1)
		len, bad = utf8.len(s)
	end
	return s
end

local function encodedLen(s)
	return #HttpService:JSONEncode({ s }) - 2
end

-- Largest cut <= i that doesn't split a UTF-8 sequence.
local function utf8Cut(s, i)
	while i > 0 and i < #s do
		local b = string.byte(s, i + 1)
		if b < 0x80 or b >= 0xC0 then
			break
		end
		i -= 1
	end
	return i
end

-- Split `s` into pieces of at most BUDGET JSON-encoded bytes, cut between
-- UTF-8 sequences. An empty string is one empty piece.
local function pieces(s)
	local out = {}
	repeat
		local size = math.min(#s, BUDGET)
		local cut, piece
		repeat
			cut = utf8Cut(s, size)
			if cut == 0 then
				cut = size
			end
			piece = string.sub(s, 1, cut)
			size = math.floor(size / 2)
		until encodedLen(piece) <= BUDGET or size < 8
		table.insert(out, piece)
		s = string.sub(s, cut + 1)
	until #s == 0
	return out
end

-- Send an event. A long `message` or `contextJson` is split into pieces
-- flagged `more`: first the message's, then the context's.
local function emit(ev)
	if ev.message ~= nil then
		ev.message = sanitize(ev.message)
	end
	local size = 0
	for _, field in { "message", "contextJson" } do
		if ev[field] ~= nil then
			size += encodedLen(ev[field])
		end
	end
	if size <= BUDGET then
		send(ev)
		return
	end
	local parts = {}
	for _, field in { "message", "contextJson" } do
		if ev[field] ~= nil then
			for _, piece in pieces(ev[field]) do
				table.insert(parts, { field, piece })
			end
		end
	end
	for i, p in parts do
		local part = table.clone(ev)
		part.message = nil
		part.contextJson = nil
		part[p[1]] = p[2]
		part.more = if i < #parts then true else nil
		send(part)
	end
end

-- The context table of a structured log message (`LogService:Info(message,
-- context)`) as a JSON object, or nil when it's empty. Roblox already flattens
-- it to string keys and string/number/boolean values; this keeps it encodable
-- if that changes.
local function contextJson(context)
	if type(context) ~= "table" or next(context) == nil then
		return nil
	end
	local flat = {}
	for k, v in context do
		local t = type(v)
		if t == "string" then
			v = sanitize(v)
		elseif t == "number" then
			if v ~= v or v == math.huge or v == -math.huge then
				v = tostring(v)
			end
		elseif t ~= "boolean" then
			v = sanitize(tostring(v))
		end
		flat[sanitize(tostring(k))] = v
	end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, flat)
	return if ok then json else nil
end

local function join(...)
	local n = select("#", ...)
	local parts = table.create(n)
	for i = 1, n do
		parts[i] = tostring((select(i, ...)))
	end
	return table.concat(parts, " ")
end

---------------------------------------------------------------------------
-- Everything else the engine prints (required modules, the engine itself)
---------------------------------------------------------------------------

local LEVELS = {
	MessageOutput = "print",
	MessageInfo = "info",
	MessageWarning = "warn",
	MessageError = "error",
}

local suppressError = {} -- errors already reported via ScriptContext.Error
local skippingStack = false
local compiling = nil -- the chunk name of the module being required, if any
local compileMessage = nil

LogService.MessageOut:Connect(function(message, messageType, context)
	if string.sub(message, 1, #SENTINEL) == SENTINEL then
		return
	end
	local level = LEVELS[messageType.Name] or "info"
	-- A compile error in a module we compile only arrives here; require itself
	-- just says the module failed to load.
	if compiling and level == "error" and string.sub(message, 1, #compiling + 1) == compiling .. ":" then
		compileMessage = message
		return
	end
	if skippingStack then
		if level == "info" then
			if message == "Stack End" then
				skippingStack = false
			end
			return
		end
		skippingStack = false
	end
	-- In a task the stack comes in the same message ("<error>\n    Stack Begin ..."),
	-- not as separate info lines as in Studio, so match on the first line.
	local firstLine = string.match(message, "^[^\n]*")
	if level == "error" and suppressError[firstLine] then
		suppressError[firstLine] = nil
		skippingStack = firstLine == message
		return
	end
	emit({
		kind = "output",
		source = "other",
		level = level,
		message = message,
		contextJson = contextJson(context),
	})
end)

-- Errors in threads the script spawned (task.spawn, connections, ...).
local function fromScript(stack)
	for name in scriptNames do
		if string.find(stack, name .. ", line", 1, true) then
			return true
		end
	end
	return false
end

ScriptContext.Error:Connect(function(message, stack, origin)
	if origin == nil and fromScript(stack) then
		suppressError[message] = true
		emit({
			kind = "output",
			source = "script",
			level = "error",
			async = true,
			message = message .. "\n" .. stack,
		})
	end
end)

---------------------------------------------------------------------------
-- ctx.inputs and ctx.setBinaryOutput
---------------------------------------------------------------------------

-- Packed by studio-run (src/binary.rs): "SRI1", the count, then for each
-- input its name's length, name, data's length and data (u32s, little-endian).
local function unpackInputs(packed)
	local inputs = {}
	assert(buffer.readstring(packed, 0, 4) == "SRI1", "studio-run: unrecognised binary input")
	local count = buffer.readu32(packed, 4)
	local pos = 8
	for _ = 1, count do
		local nameLen = buffer.readu32(packed, pos)
		local name = buffer.readstring(packed, pos + 4, nameLen)
		pos += 4 + nameLen
		local len = buffer.readu32(packed, pos)
		local data = buffer.create(len)
		buffer.copy(data, 0, packed, pos + 4, len)
		pos += 4 + len
		inputs[name] = data
	end
	return inputs
end

local taskInput = if type(TASK_ARGS[1]) == "table" then TASK_ARGS[1].BinaryInput else nil
local inputs = if taskInput then unpackInputs(taskInput) else {}
taskInput = nil
TASK_ARGS = nil

local binaryOutput = nil

CONTEXT.inputs = inputs

function CONTEXT.setBinaryOutput(data)
	if type(data) == "string" then
		data = buffer.fromstring(data)
	elseif typeof(data) ~= "buffer" then
		error("ctx.setBinaryOutput expects a buffer, got " .. typeof(data), 2)
	end
	if buffer.len(data) > MAX_TASK_OUTPUT then
		error(
			string.format(
				"binary output is %d bytes; the limit is %d bytes (256 MiB) in the cloud",
				buffer.len(data),
				MAX_TASK_OUTPUT
			),
			2
		)
	end
	binaryOutput = data
end

---------------------------------------------------------------------------
-- Compiling and the script's environment
---------------------------------------------------------------------------

-- Compile `source` as a ModuleScript named `name` (its chunk name), as the
-- body of `function(...)` starting on the module's first line, so line
-- numbers are the source's. Returns the function, or nil and the error.
local function compile(name, source)
	local module = Instance.new("ModuleScript")
	module.Name = name
	module.Source = "return function(...) " .. source .. "\nend"
	compiling = name
	compileMessage = nil
	local loaded, fn = pcall(realRequire, module)
	if loaded then
		compiling = nil
		return fn
	end
	-- The real message comes through MessageOut, possibly a moment later.
	local waitUntil = os.clock() + 2
	while compileMessage == nil and os.clock() < waitUntil do
		task.wait()
	end
	compiling = nil
	return nil, compileMessage or tostring(fn)
end

local tracedRequire
local function makeEnv(scriptValue)
	local env = setmetatable({}, { __index = wrapperEnv })
	if CAPTURE_PRINT then
		env.print = function(...)
			emit({ kind = "output", source = "script", level = "print", message = join(...) })
		end
		env.warn = function(...)
			emit({ kind = "output", source = "script", level = "warn", message = join(...) })
		end
	end
	if TRACE_MODULES then
		env.require = tracedRequire
	end
	env.script = scriptValue
	return env
end

-- Opt-in (--trace-modules): load ModuleScripts ourselves so their output and
-- errors are attributed to them. Not the real `require`; see
-- docs/guide/test-runners.md. Each module is compiled under its full name, as
-- the local wrapper's loadstring names it.
local moduleCache = {}
local LOADING = {}
tracedRequire = function(target)
	if typeof(target) ~= "Instance" or not target:IsA("ModuleScript") then
		return realRequire(target)
	end
	local cached = moduleCache[target]
	if cached == LOADING then
		error("studio-run: cyclic require of " .. target:GetFullName(), 2)
	elseif cached ~= nil then
		return cached.value
	end
	local name = target:GetFullName()
	local fn, err = compile(name, target.Source)
	if not fn then
		error(err, 0)
	end
	scriptNames[name] = true
	moduleCache[target] = LOADING
	setfenv(fn, makeEnv(target))
	local results = table.pack(pcall(fn))
	if not results[1] then
		moduleCache[target] = nil
		error(results[2], 0)
	end
	if results.n ~= 2 then
		moduleCache[target] = nil
		error("Module code did not return exactly one value: " .. name, 2)
	end
	moduleCache[target] = { value = results[2] }
	return results[2]
end

---------------------------------------------------------------------------
-- Run
---------------------------------------------------------------------------

local function exitCodeFrom(value)
	if value == nil or value == true then
		return 0
	elseif value == false then
		return 1
	elseif type(value) == "number" then
		return math.floor(value)
	elseif type(value) == "table" and type(value.exitCode) == "number" then
		return math.floor(value.exitCode)
	end
	return 0
end

-- Drop the wrapper's own frames ("TaskScript:N") from tracebacks.
local function cleanTraceback(tb)
	local kept = {}
	for line in string.gmatch(tb, "[^\n]+") do
		if not string.find(line, "^TaskScript:") then
			table.insert(kept, line)
		end
	end
	return table.concat(kept, "\n")
end

emit({ kind = "start", chunk = CHUNK_NAME })

local result
local fn, compileErr = compile(CHUNK_NAME, SOURCE)
if not fn then
	emit({ kind = "output", source = "script", level = "error", message = compileErr })
	result = { ok = false, exitCode = 1, reason = "compile" }
else
	if CAPTURE_PRINT or TRACE_MODULES then
		setfenv(fn, makeEnv(nil))
	end
	local packed = table.pack(xpcall(fn, function(e)
		return { message = tostring(e), traceback = cleanTraceback(debug.traceback(nil, 2)) }
	end, CONTEXT))
	if packed[1] then
		result = { ok = true, exitCode = exitCodeFrom(packed[2]), reason = "returned" }
	else
		local e = packed[2]
		local message = e.message
		if e.traceback ~= "" then
			message ..= "\n" .. e.traceback
		end
		emit({ kind = "output", source = "script", level = "error", message = message })
		result = { ok = false, exitCode = 1, reason = "error" }
	end
end

-- Let deferred MessageOut / ScriptContext.Error events arrive first.
task.wait(0.1)
task.wait(0.1)

local data = if SEND_BINARY_OUTPUT then binaryOutput else nil
-- Room for the header and the result event still to come.
if data and 12 + linesBytes + 1024 + buffer.len(data) > MAX_TASK_OUTPUT then
	emit({
		kind = "output",
		source = "script",
		level = "error",
		message = string.format(
			"studio-run: the binary output (%d bytes) and the output events (%d bytes) together "
				.. "are more than a task can return (256 MiB); the binary output was dropped",
			buffer.len(data),
			linesBytes
		),
	})
	data = nil
	if result.ok then
		result = { ok = false, exitCode = 1, reason = "error" }
	end
end

emit({ kind = "result", ok = result.ok, exitCode = result.exitCode, reason = result.reason })

-- "SRB1", the events' length, the binary output's length (u32s,
-- little-endian), the events, the binary output. Read by src/binary.rs.
local events = table.concat(lines, "\n")
local dataLen = if data then buffer.len(data) else 0
local out = buffer.create(12 + #events + dataLen)
buffer.writestring(out, 0, "SRB1")
buffer.writeu32(out, 4, #events)
buffer.writeu32(out, 8, dataLen)
buffer.writestring(out, 12, events)
if data then
	buffer.copy(out, 12 + #events, data)
end

return {
	BinaryOutput = out,
	ReturnValues = { result },
}
