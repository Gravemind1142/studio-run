# Settings for the Open Cloud tests. Copy this file to .env (which git ignores)
# and fill it in. See docs/cloud-testing.md. Variables already set in the
# environment take precedence over this file.

# Your test experience (Creator Dashboard > Creations).
STUDIO_RUN_TEST_UNIVERSE_ID=
STUDIO_RUN_TEST_PLACE_ID=

# An Open Cloud API key restricted to that experience.
STUDIO_RUN_TEST_API_KEY=
